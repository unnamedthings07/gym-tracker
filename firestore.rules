rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Private account data: only the owning authenticated user can access it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Public movie snapshot: anyone can read, only the movie account can write.
    match /publicMovies/tracker {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == "unnamedboy07@gmail.com";
    }
  }
}